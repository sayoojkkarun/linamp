[Desktop Entry]
Type=Application
Name=Linamp
GenericName=Audio Player
Comment=Winamp-style skinnable audio player
Exec=linamp %U
Icon=multimedia-audio-player
Terminal=false
Categories=AudioVideo;Audio;Player;
Keywords=music;player;winamp;skin;mp3;flac;
MimeType=audio/mpeg;audio/mp3;audio/flac;audio/x-flac;audio/ogg;audio/x-vorbis+ogg;audio/vorbis;audio/mp4;audio/x-m4a;audio/aac;audio/wav;audio/x-wav;audio/x-aiff;audio/x-matroska;audio/x-mpegurl;audio/mpegurl;application/vnd.apple.mpegurl;audio/x-scpls;application/xspf+xml;application/x-linamp-skin;
StartupWMClass=linamp
Actions=PlayPause;Next;Previous;

[Desktop Action PlayPause]
Name=Play/Pause
Exec=linamp /PLAYPAUSE

[Desktop Action Next]
Name=Next
Exec=linamp /NEXT

[Desktop Action Previous]
Name=Previous
Exec=linamp /PREV
